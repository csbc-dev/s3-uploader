# --- Target bucket (REQUIRED) ---------------------------------------------
# The S3 (or S3-compatible) bucket every upload lands in. The client never
# sees or sets this — the server pins it (see ScopedS3Core in server.js).
# Left empty on purpose: server.js exits at startup with a clear
# "S3_BUCKET is required" message if you forget to set it, rather than
# starting up and only failing on the first upload with an opaque
# NoSuchBucket / AccessDenied. Set it to your real bucket name.
S3_BUCKET=

# --- AWS credentials (REQUIRED for real AWS) ------------------------------
# These stay on the server. This is the whole point of remote mode: the
# browser only ever receives short-lived presigned URLs, never the keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for temporary STS credentials:
# AWS_SESSION_TOKEN=

# Region of the bucket. AWS_DEFAULT_REGION is also accepted.
AWS_REGION=us-east-1

# --- Key scoping ----------------------------------------------------------
# Base prefix every upload is nested under. The server appends a
# per-connection segment (S3_PREFIX + "<session>/") so each tab is isolated.
# In production, derive the per-user part from the authenticated session.
S3_PREFIX=s3-uploader-demo/

# --- S3-compatible stores (OPTIONAL) --------------------------------------
# For MinIO / Cloudflare R2 / Wasabi / etc., point at the custom endpoint.
#   MinIO:  S3_ENDPOINT=http://localhost:9000   S3_FORCE_PATH_STYLE=true
#   R2:     S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- Server ---------------------------------------------------------------
# WebSocket port. Clients connect to ws://localhost:${PORT}/s3-uploader
# If you change this, update every client's URL too: the Vite clients'
# VITE_S3_REMOTE_URL (each .env) and wcstack-state's window.S3_REMOTE_CORE_URL
# (index.html). They are NOT derived from this value automatically.
PORT=8080
